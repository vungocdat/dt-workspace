KB_USERNAME=admin
KB_PASSWORD_HASH=<bcrypt hash — generate with: npm run setup -- --username admin --password yourpassword>
SESSION_SECRET=<32-char random string>
PORT=3333
# Listen address: 127.0.0.1 = this machine only (behind nginx), 0.0.0.0 = every interface
HOST=127.0.0.1
DATABASE_URL=postgres://dt_workspace:<password>@localhost:5432/dt_workspace
NODE_ENV=development
